Bootstrap: docker
From: ubuntu:24.04

%labels
    Author AutoHog
    Description Container for AutoHog EPFL benchmark synthesis

%post
    # Avoid interactive prompts
    export DEBIAN_FRONTEND=noninteractive

    # Install system dependencies
    apt-get update && apt-get install -y \
        python3 \
        python3-pip \
        python3-dev \
        yosys \
        build-essential \
        git \
        && rm -rf /var/lib/apt/lists/*

    # Install Python packages
    pip3 install --break-system-packages \
        matplotlib==3.6.3 \
        networkx==2.8.8 \
        numpy==1.26.4 \
        pandas \
        z3-solver

%environment
    export LC_ALL=C
    export PATH=/usr/bin:/usr/local/bin:$PATH

%runscript
    cd /AutoHog
    exec python3 run_epfl_all.py "$@"

%help
    AutoHog EPFL benchmark synthesis container.

    Usage:
      # Run EPFL benchmark (bind-mount the repo so outputs are written back to host):
      apptainer run --bind /path/to/AutoHog:/AutoHog autohog.sif

      # Or run an arbitrary command inside the container:
      apptainer exec --bind /path/to/AutoHog:/AutoHog autohog.sif python3 run_epfl_all.py
